---
import Layout from '../layouts/Layout.astro';
const pageTitle = "Experience";
---
<Layout pageTitle={pageTitle}>
    <div class="gif">
        <img width="300" height="259" alt="RaccoonLaptopGif" src="/laptop.webp"/>
    </div>
    <h2>Experience</h2>
    <div class="tl">
        <div class="tl-item">
            <div class="tl-dot"></div>
            <div class="tl-content">
                <div class="tl-date">2024/05 - Present · Sunnyvale, CA</div>
                <div class="tl-title">Software Engineer @ Walmart Labs</div>
                <div class="tl-desc">LMD, Walmart Global Tech</div>
            </div>
        </div>
        <div class="tl-item">
            <div class="tl-dot"></div>
            <div class="tl-content">
                <div class="tl-date">2022/06 - 2022/09 · MTV, CA</div>
                <div class="tl-title">SDE Intern @ TikTok</div>
                <div class="tl-desc">MLSys Team, DataAML, TikTok/ByteDance</div>
            </div>
        </div>
        <div class="tl-item">
            <div class="tl-dot"></div>
            <div class="tl-content">
                <div class="tl-date">2020/09 - 2021/07 · Beijing, China</div>
                <div class="tl-title">Research Intern @ THUNLP</div>
                <div class="tl-desc">RA @ THUNLP Lab, TsingHua University</div>
            </div>
        </div>
        <div class="tl-item">
            <div class="tl-dot"></div>
            <div class="tl-content">
                <div class="tl-date">2019/06 - 2019/08 · Beijing, China</div>
                <div class="tl-title">MTS Intern @ VMware</div>
                <div class="tl-desc">R&D Department, VMware</div>
            </div>
        </div>
    </div>

    <h2>Education</h2>
    <div class="tl">
        <div class="tl-item">
            <div class="tl-dot tl-dot--edu"></div>
            <div class="tl-content">
                <div class="tl-date">2021 - 2023 · Davis, CA</div>
                <div class="tl-title">University of California, Davis</div>
                <div class="tl-desc">M.S. in Computer Science, GPA: 3.96/4, TA for ECS174 Computer Vision</div>
            </div>
        </div>
        <div class="tl-item">
            <div class="tl-dot tl-dot--edu"></div>
            <div class="tl-content">
                <div class="tl-date">2018 - 2020 · Manchester, UK</div>
                <div class="tl-title">The University of Manchester</div>
                <div class="tl-desc">Exchange Program: B.S.(Hons) in Artificial Intelligence, GPA: 82.5/100 (First Class - top 10%)</div>
            </div>
        </div>
        <div class="tl-item">
            <div class="tl-dot tl-dot--edu"></div>
            <div class="tl-content">
                <div class="tl-date">2016 - 2020 · Wuhan, China</div>
                <div class="tl-title">Huazhong University of Science and Technology</div>
                <div class="tl-desc">B.E. in Computer Science and Technology</div>
            </div>
        </div>
    </div>
</Layout>

<style>
    .tl {
        position: relative;
        margin: 1rem 0 2rem;
        padding-left: 28px;
    }

    .tl::before {
        content: "";
        position: absolute;
        left: 6px;
        top: 4px;
        bottom: 4px;
        width: 2px;
        background: var(--underline);
    }

    .tl-item {
        position: relative;
        padding-bottom: 1.8rem;
        opacity: 0;
        transform: translateY(20px);
        animation: fadeInUp 0.5s ease forwards;
    }

    .tl-item:nth-child(1) { animation-delay: 0.1s; }
    .tl-item:nth-child(2) { animation-delay: 0.25s; }
    .tl-item:nth-child(3) { animation-delay: 0.4s; }
    .tl-item:nth-child(4) { animation-delay: 0.55s; }

    .tl-item:last-child {
        padding-bottom: 0;
    }

    .tl-dot {
        position: absolute;
        left: -28px;
        top: 4px;
        width: 14px;
        height: 14px;
        box-sizing: border-box;
        border-radius: 50%;
        background: var(--button);
        border: 2px solid var(--underline);
        z-index: 1;
    }

    .tl-dot--edu {
        background: #9251ac;
    }

    .tl-content {
        padding: 0.8rem 1rem;
        border-radius: 8px;
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.08);
        transition: background 0.2s, border-color 0.2s;
    }

    .tl-content:hover {
        background: rgba(255, 255, 255, 0.09);
        border-color: rgba(255, 255, 255, 0.15);
    }

    .tl-date {
        font-family: var(--body);
        font-size: 0.82rem;
        opacity: 0.6;
        margin-bottom: 0.3rem;
    }

    .tl-title {
        font-family: var(--body);
        font-size: 1.05rem;
        font-weight: 600;
        line-height: 1.4;
    }

    .tl-desc {
        font-family: var(--body);
        font-size: 0.9rem;
        opacity: 0.75;
        margin-top: 0.25rem;
        line-height: 1.5;
    }

    /* Light mode overrides */
    :global(html.light) .tl-content {
        background: rgba(0, 0, 0, 0.03);
        border-color: rgba(0, 0, 0, 0.08);
    }

    :global(html.light) .tl-content:hover {
        background: rgba(0, 0, 0, 0.06);
        border-color: rgba(0, 0, 0, 0.14);
    }

    @keyframes fadeInUp {
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>